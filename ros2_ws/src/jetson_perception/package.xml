<?xml version="1.0"?>
<package format="3">
  <name>jetson_perception</name>
  <version>0.1.0</version>
  <description>Offline perception nodes used by the Jetson embodied AI course.</description>
  <maintainer email="lgy10271416@gmail.com">lgy1027</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>jetson_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <!-- 告诉 colcon 这是 Python 包，构建时应执行 setup.py。 -->
    <build_type>ament_python</build_type>
  </export>
</package>
